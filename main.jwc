// MyWallet — personal finance API written in JWC.
//
// Features: Auth (register/login + JWT), Wallets, Categories, Transactions
// (income/expense with atomic balance updates) and per-user Stats.
// main() wires the DB connection from PG_* env vars and starts the server.
function main() {
    // Reads PG_* / DATABASE_URL from env. Without this every DB-touching
    // route 500s.
    setConnectionString();

    let port_env = env("PORT");
    let port = 8080;
    if (port_env != "") {
        port = int(port_env);
    }
    serve(port);
}
