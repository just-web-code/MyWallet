namespace routes.auth;

import dto.auth;
import middleware.ratelimit;
import services.auth;

routes "/auth" use StrictRateLimit {
    route POST "register" {
        let req = request.body() as RegisterRequest;
        let account = AuthService.register($req);

        return created(json($account));
    }

    route POST "login" {
        let req = request.body() as LoginRequest;
        let token = AuthService.login($req);

        return json({ token: $token });
    }
}
