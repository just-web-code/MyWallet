namespace services.stats;

import app;
import db.schema;

service StatsService {
    /// A user's finances in one answer: how many wallets, the total across
    /// them, and lifetime income / expense / net from the ledger.
    ///
    /// Both rollups are aggregated in Postgres. The ledger is never streamed
    /// into the process just to be summed here — the 0.9.x version had the
    /// same property and it is worth keeping: this is the one endpoint whose
    /// cost grows with a user's history.
    function summary(account_id: int) {
        let wallets = select W from App.public.Wallets
            where W.user_id == @account_id
            as {
                count: count(W.id),
                balance: sum(W.balance)
            }
            first;

        // One row per `is_income` value — at most two, not one per row.
        let buckets = select T from App.public.Transactions
            where T.user_id == @account_id
            group by T.is_income
            as {
                T.is_income,
                summa: sum(T.amount)
            };

        let income = 0;
        let expense = 0;
        for (let b in @buckets) {
            let amount = int(@b.summa ?? 0);
            if (@b.is_income) {
                @income = @income + @amount;
            } else {
                @expense = @expense + @amount;
            }
        }

        return {
            wallets: @wallets.count,
            // `sum` answers `numeric`, carried as a JSON string so no float
            // touches money (types.md §2.1). These are whole so'm and the
            // client reads them as numbers, so they are narrowed back here.
            total_balance: int(@wallets.balance ?? 0),
            total_income: @income,
            total_expense: @expense,
            net: @income - @expense
        };
    }
}
