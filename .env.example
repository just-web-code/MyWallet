PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=password
PG_DATABASE=MyWallet

JWT_SECRET=change-me-in-production
PORT=8080

# CORS (jwc >= 0.7.0). Off unless JWC_CORS_ORIGINS is set, so the API stays
# same-origin by default. Setting this removes the need for a reverse proxy in
# front of the Angular client. `*` together with credentials is rejected at boot.
# JWC_CORS_ORIGINS=http://localhost:4200
# JWC_CORS_METHODS=GET,POST,PATCH,DELETE,OPTIONS
# JWC_CORS_HEADERS=authorization,content-type
# JWC_CORS_EXPOSE_HEADERS=
# JWC_CORS_CREDENTIALS=false
# JWC_CORS_MAX_AGE=600

# Local debugging only: echoes internal error detail (Rust types, SQL) in 500s.
# JWC_DEBUG_ERRORS=1
