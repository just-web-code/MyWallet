// Fixed-window per-IP rate limit: 60 requests / 60s, keyed on the client IP.
// Backed by the in-process cache — single replica only; behind multiple pods
// use a shared cache (Redis). Applied to the public auth routes to blunt
// credential-stuffing / registration abuse.
middleware RateLimit {
    // client_ip() returns null when no proxy header (x-forwarded-for) is
    // present — e.g. direct connections in dev. Fall back to a shared bucket
    // so the limit still applies.
    let ip = client_ip();
    if (ip == null or ip == "") {
        ip = "unknown";
    }
    let key = "rl:" + ip;
    let count = cache_get(key);
    if (count == null) {
        cache_set(key, "1", 60);
    } else {
        let n = int(count) + 1;
        if (n >= 60) {
            return statusCode(429, { error: "rate limited" });
        }
        cache_set(key, "" + n, 60);
    }
}
