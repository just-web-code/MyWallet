route GET "/categories" use AuthMiddleware {
    let userId = context("userId");
    return json(CategoryService.listByUser(userId));
}

route POST "/categories" use AuthMiddleware {
    validate body {
        name: required, minLength(1), maxLength(100);
    }
    let userId = context("userId");
    let req = body();
    if (CategoryService.findByName(userId, req.name) != null) {
        return badRequest({ error: "category name already exists" });
    }
    let desc = req.description;
    if (desc == null) {
        desc = "";
    }
    let c = CategoryService.create(userId, req.name, desc);
    return created(json(c));
}

route GET "/categories/{id}" use AuthMiddleware {
    let userId = context("userId");
    let id = int(path_param("id"));
    let c = CategoryService.getById(id);
    if (c == null) {
        return notFound();
    }
    if (c.user_id != userId) {
        return forbidden();
    }
    return json(c);
}

route PATCH "/categories/{id}" use AuthMiddleware {
    let userId = context("userId");
    let id = int(path_param("id"));
    let c = CategoryService.getById(id);
    if (c == null) {
        return notFound();
    }
    if (c.user_id != userId) {
        return forbidden();
    }
    return json(CategoryService.update(id, body()));
}

route DELETE "/categories/{id}" use AuthMiddleware {
    let userId = context("userId");
    let id = int(path_param("id"));
    let c = CategoryService.getById(id);
    if (c == null) {
        return notFound();
    }
    if (c.user_id != userId) {
        return forbidden();
    }
    CategoryService.remove(id);
    return noContent();
}
