dome WalletService {
    function create(userId: int, name: string, currency: string, balance: int) {
        let w = new Wallet();
        w.user_id    = userId;
        w.name       = name;
        w.balance    = balance;
        w.currency   = currency;
        w.created_at = now();
        insert w into AppDbContext.Wallet;
        return w;
    }

    function listByUser(userId: int) {
        return select Wallet from AppDbContext.Wallet
            where Wallet.user_id == @userId
            orderby Wallet.created_at desc;
    }

    function getById(id: int): Wallet? {
        return select Wallet from AppDbContext.Wallet where Wallet.id == @id first;
    }

    function update(id: int, req: UpdateWalletRequest) {
        let w = select Wallet from AppDbContext.Wallet where Wallet.id == @id first;
        if (w == null) {
            return null;
        }
        if (req.name != null) {
            w.name = req.name;
        }
        if (req.currency != null) {
            w.currency = req.currency;
        }
        update w in AppDbContext.Wallet;
        return w;
    }

    // Shift a wallet's balance by `delta` (negative for expenses). Called
    // inside the transaction that writes/removes a Transaction row so the
    // balance and the ledger never drift.
    function adjustBalance(id: int, delta: int) {
        let w = select Wallet from AppDbContext.Wallet where Wallet.id == @id first;
        if (w == null) {
            return null;
        }
        w.balance += delta;
        update w in AppDbContext.Wallet;
        return w;
    }

    // Wipe the wallet and its transactions in one transaction.
    function deleteDeep(id: int) {
        transaction {
            delete from AppDbContext.Transaction where Transaction.wallet_id == @id;
            delete from AppDbContext.Wallet where Wallet.id == @id;
        }
    }
}
