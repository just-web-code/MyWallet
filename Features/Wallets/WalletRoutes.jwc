route GET "/wallets" use AuthMiddleware {
    let userId = context("userId");
    return json(WalletService.listByUser(userId));
}

route POST "/wallets" use AuthMiddleware {
    validate body {
        name:     required, minLength(1), maxLength(120);
        currency: required, minLength(1), maxLength(10);
    }
    let userId = context("userId");
    let req = body();
    let balance = req.balance;
    if (balance == null) {
        balance = 0;
    }
    let w = WalletService.create(userId, req.name, req.currency, balance);
    return created(json(w));
}

route GET "/wallets/{id}" use AuthMiddleware {
    let userId = context("userId");
    let id = int(path_param("id"));
    let w = WalletService.getById(id);
    if (w == null) {
        return notFound();
    }
    if (w.user_id != userId) {
        return forbidden();
    }
    return json(w);
}

route PATCH "/wallets/{id}" use AuthMiddleware {
    let userId = context("userId");
    let id = int(path_param("id"));
    let w = WalletService.getById(id);
    if (w == null) {
        return notFound();
    }
    if (w.user_id != userId) {
        return forbidden();
    }
    return json(WalletService.update(id, body()));
}

route DELETE "/wallets/{id}" use AuthMiddleware {
    let userId = context("userId");
    let id = int(path_param("id"));
    let w = WalletService.getById(id);
    if (w == null) {
        return notFound();
    }
    if (w.user_id != userId) {
        return forbidden();
    }
    WalletService.deleteDeep(id);
    return noContent();
}
