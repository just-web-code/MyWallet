dome StatsService {
    // Roll up a user's finances: how many wallets, total balance across them,
    // and lifetime income / expense / net from the transaction ledger.
    //
    // Both rollups are aggregated in Postgres — the ledger is never streamed
    // into the app just to be summed here.
    function summary(userId: int) {
        let walletAgg = select Wallet { cnt: count(*), total: sum(balance) }
            from AppDbContext.Wallet
            where Wallet.user_id == @userId first;

        let walletCount = 0;
        let totalBalance = 0;
        if (walletAgg != null) {
            walletCount = walletAgg.cnt ?? 0;
            totalBalance = walletAgg.total ?? 0;
        }

        // One row per is_income value (at most two), not one row per transaction.
        let buckets = select Transaction { is_income, summa: sum(amount) }
            from AppDbContext.Transaction
            where Transaction.user_id == @userId
            group by is_income;

        let income = 0;
        let expense = 0;
        for b in buckets {
            let summa = b.summa ?? 0;
            if (b.is_income == true) {
                income += summa;
            } else {
                expense += summa;
            }
        }

        return {
            wallets:       walletCount,
            total_balance: totalBalance,
            total_income:  income,
            total_expense: expense,
            net:           income - expense
        };
    }
}
