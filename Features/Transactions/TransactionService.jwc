dome TransactionService {
    // Book a transaction and move the wallet balance in the SAME transaction so
    // the ledger and the running balance can never drift. Income adds, expense
    // subtracts. The category's usage counter is bumped too.
    function create(userId: int, walletId: int, categoryId: int, amount: decimal, isIncome: bool, description: string) {
        let t = new Transaction();
        transaction {
            t.wallet_id   = walletId;
            t.category_id = categoryId;
            t.amount      = amount;
            t.is_income   = isIncome;
            t.description = description;
            t.user_id     = userId;
            t.created_at  = now();
            insert t into AppDbContext.Transaction;

            let delta = amount;
            if (isIncome == false) {
                delta = 0 - amount;
            }
            WalletService.adjustBalance(walletId, delta);
            CategoryService.incrementUsage(categoryId);
        }
        return t;
    }

    function listByWallet(walletId: int, limit: int, offset: int) {
        let total = select count(*) from AppDbContext.Transaction
            where Transaction.wallet_id == @walletId;
        let items = select Transaction from AppDbContext.Transaction
            where Transaction.wallet_id == @walletId
            orderby Transaction.created_at desc
            limit @limit offset @offset;
        return { items: items, limit: limit, offset: offset, total: total };
    }

    function getById(id: int): Transaction? {
        return select Transaction from AppDbContext.Transaction where Transaction.id == @id first;
    }

    // Reverse the balance effect, then delete — both in one transaction.
    function remove(t) {
        let tid = t.id;
        transaction {
            let delta = t.amount;
            if (t.is_income == true) {
                delta = 0 - t.amount;
            }
            WalletService.adjustBalance(t.wallet_id, delta);
            delete from AppDbContext.Transaction where Transaction.id == @tid;
        }
    }
}
