route GET "/wallets/{wid}/transactions" use AuthMiddleware {
    let userId = context("userId");
    let wid = int(path_param("wid"));
    let w = WalletService.getById(wid);
    if (w == null) {
        return notFound();
    }
    if (w.user_id != userId) {
        return forbidden();
    }
    let limit = 20;
    let limitStr = query_param("limit");
    if (limitStr != "") {
        limit = int(limitStr);
    }
    let offset = 0;
    let offsetStr = query_param("offset");
    if (offsetStr != "") {
        offset = int(offsetStr);
    }
    return json(TransactionService.listByWallet(wid, limit, offset));
}

route POST "/wallets/{wid}/transactions" use AuthMiddleware {
    validate body {
        amount:      required;
        category_id: required;
    }
    let userId = context("userId");
    let wid = int(path_param("wid"));
    let w = WalletService.getById(wid);
    if (w == null) {
        return notFound();
    }
    if (w.user_id != userId) {
        return forbidden();
    }
    let req = body();
    let cat = CategoryService.getById(req.category_id);
    if (cat == null) {
        return badRequest({ error: "invalid category" });
    }
    if (cat.user_id != userId) {
        return forbidden();
    }
    let isIncome = req.is_income;
    if (isIncome == null) {
        isIncome = false;
    }
    let desc = req.description;
    if (desc == null) {
        desc = "";
    }
    let t = TransactionService.create(userId, wid, req.category_id, req.amount, isIncome, desc);
    return created(json(t));
}

route GET "/transactions/{id}" use AuthMiddleware {
    let userId = context("userId");
    let id = int(path_param("id"));
    let t = TransactionService.getById(id);
    if (t == null) {
        return notFound();
    }
    if (t.user_id != userId) {
        return forbidden();
    }
    return json(t);
}

route DELETE "/transactions/{id}" use AuthMiddleware {
    let userId = context("userId");
    let id = int(path_param("id"));
    let t = TransactionService.getById(id);
    if (t == null) {
        return notFound();
    }
    if (t.user_id != userId) {
        return forbidden();
    }
    TransactionService.remove(t);
    return noContent();
}
