dbcontext AppDbContext: Postgres;

entity User of AppDbContext {
    id            int pk autoincrement;   // primary key, auto-increment
    first_name    varchar(120);
    last_name     varchar(120);
    email         varchar(255) unique;
    password_hash varchar(255);
    created_at    datetime;
    wallets:      List<Wallet> via Wallet.user_id orderby created_at desc; // one-to-many relationship with Wallet
}

entity Wallet of AppDbContext {
    id         int pk autoincrement;   // primary key, auto-increment
    user_id    int references User.id on delete cascade; // foreign key to User
    name       varchar(120);
    balance    int; // integer amount in so'm (JWC binds small ints as int4, not int8)
    currency   varchar(10);
    created_at datetime;
}

entity Category of AppDbContext {
    id          int pk autoincrement;   // primary key, auto-increment
    name        varchar(100);
    description varchar(255);
    usage_count int; // number of times this category has been used
    user_id     int references User.id on delete cascade; // foreign key to User
    created_at  datetime;
}

entity Transaction of AppDbContext {
    id          int pk autoincrement;   // primary key, auto-increment
    wallet_id   int references Wallet.id on delete cascade; // foreign key to Wallet
    category_id int references Category.id; // foreign key to Category
    amount      int; // integer amount in so'm
    is_income   bool; // true for income, false for expense
    description varchar(255);
    created_at  datetime;
    user_id     int references User.id on delete cascade; // foreign key to User
    wallet: Wallet via wallet_id; // many-to-one relationship with Wallet
    category: Category via category_id; // many-to-one relationship with Category
}